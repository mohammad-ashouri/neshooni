APP_NAME="نشونی"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# کنسول ملی پیامک (خالی = پیامک فقط در لاگ ثبت می‌شود)
# OTP_BODY_ID: کد الگوی تأییدشده با متنی مثل «کد بازیابی نشونی: {0}»
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=
MELIPAYAMAK_OTP_BODY_ID=
# الگوی کد ثبت‌نام، مثل «کد تأیید ثبت‌نام در نشونی: {0}» (خالی = همان الگوی بالا)
MELIPAYAMAK_REGISTER_BODY_ID=

# کپچای فرم ورود (فقط برای تست خودکار true شود)
CAPTCHA_DISABLE=false

# تا آماده انتشار نشده، همه صفحه‌ها noindex هستند
SEO_NOINDEX=true

# حساب مدیر اصلی که با php artisan migrate --seed ساخته می‌شود
ADMIN_NAME=مدیر
ADMIN_MOBILE=
ADMIN_PASSWORD=

#--------------------------------------------------------------------------
# درگاه‌های پرداخت (پکیج shetabit/payment، تنظیمات در config/payment.php)
#--------------------------------------------------------------------------
# درگاه‌هایی که در صفحه پرداخت به کاربر نشان داده می‌شوند، با ویرگول و به ترتیب نمایش:
#   PAYMENT_GATEWAYS=zarinpal,zibal,behpardakht
# local «درگاه تست» است (بدون کسر پول) و در APP_ENV=production هرگز نمایش داده نمی‌شود.
# آدرس بازگشت از درگاه خودکار ساخته می‌شود؛ در پنل درگاه دامنه سایت را ثبت کنید.
# مبالغ سایت تومان است و برای درگاه‌های ریالی خودکار تبدیل می‌شود.
# حالت آزمایشی: PAYMENT_ZARINPAL_MODE=sandbox، PAYMENT_ZIBAL_MERCHANT_ID=zibal، PAYMENT_IRANDARGAH_SANDBOX=true و...
# هر تنظیم دیگر پکیج هم با همین الگو قابل تغییر است: PAYMENT_{درگاه}_{تنظیم} (مثل PAYMENT_ZARINPAL_API_PURCHASE_URL)
# درگاه‌های ارزی فقط با تعیین نرخ (چند تومان به ازای یک واحد ارز) نمایش داده می‌شوند.
PAYMENT_GATEWAYS=local

# زرین‌پال
PAYMENT_ZARINPAL_MODE=normal
PAYMENT_ZARINPAL_MERCHANT_ID=

